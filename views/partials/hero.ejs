<div id="hero">
    <div id="hero-box">
        <p id="hero1">Discover Your Next</p>
        <p id="hero2">Favorite TV Show</p>
        <p id="hero-subtitle">Search for your favorite shows, explore details, episodes,cast and more.</p>
        <form class="hero-search" action="/search" method="POST" role="search">
            <i class="bi bi-search hero-search-icon" aria-hidden="true"></i>
            <input
                type="search"
                name="query"
                placeholder="Search TV shows..."
                aria-label="Search TV shows"
                required
            >
            <button id="hero-button" type="submit">Search</button>
        </form>
    </div>
</div>